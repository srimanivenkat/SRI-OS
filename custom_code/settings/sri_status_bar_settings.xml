<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="SRI OS Status Bar Tweaks">

    <!-- Clock Settings -->
    <PreferenceCategory android:title="Clock">
        <SwitchPreference
            android:key="status_bar_clock_seconds"
            android:title="Show Clock Seconds"
            android:summary="Display seconds next to the time (e.g. 10:45:30 AM)"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Battery Settings -->
    <PreferenceCategory android:title="Battery">
        <ListPreference
            android:key="status_bar_battery_style"
            android:title="Battery Style"
            android:entries="@array/battery_style_entries"
            android:entryValues="@array/battery_style_values"
            android:defaultValue="vertical_percent_inside" />
    </PreferenceCategory>

    <!-- Network Traffic Monitor -->
    <PreferenceCategory android:title="Network Traffic">
        <SwitchPreference
            android:key="network_traffic_state"
            android:title="Enable Network Monitor"
            android:summary="Show Download (Top) and Upload (Bottom) speeds"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Icon Styles -->
    <PreferenceCategory android:title="Icon Themes">
        <ListPreference
            android:key="status_bar_icon_style"
            android:title="System Icon Pack"
            android:summary="Change Wi-Fi and Cellular icon styles"
            android:entries="@array/icon_style_entries"
            android:entryValues="@array/icon_style_values"
            android:defaultValue="filled" />
    </PreferenceCategory>

</PreferenceScreen>
